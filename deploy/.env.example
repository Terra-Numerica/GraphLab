# Copier vers deploy/.env : cp .env.example .env

PORT=3000
NODE_ENV=production
MONGODB_URL=mongodb://mongo:27017/graphlab
MONGO_PORT=27017
VITE_API_URL=http://localhost:3000/api

# Dossier des sauvegardes MongoDB (local : relatif, prod : chemin absolu)
BACKUP_DIR=./backups/mongodb

# Forcer la réinitialisation des données au prochain démarrage (0 ou 1)
FORCE_INIT=0

# Production derrière Traefik :
# VITE_API_URL=https://portail.terra-numerica.org/graphlab/api
# BACKUP_DIR=/srv/graphlab/backups/mongodb
