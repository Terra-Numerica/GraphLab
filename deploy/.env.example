# Copier vers deploy/.env : cp .env.example .env

APP_ID=graphlab
# Doit correspondre à APP_ID (préfixe des volumes/réseaux Docker)
COMPOSE_PROJECT_NAME=graphlab

# Image Docker (prod : pull depuis le registry ; dev : build local)
IMAGE_REGISTRY=registry.gitlab.com/terra-numerica-public
IMAGE_NAME=graphlab
IMAGE_VERSION=latest
PORT=3000
NODE_ENV=production
MONGODB_URL=mongodb://mongo:27017/graphlab
MONGO_PORT=27017
VITE_API_URL=http://localhost:3000/api
FORCE_INIT=0

# Serveur externe de sauvegardes (obligatoire en production)
BACKUP_REMOTE_HOST=backup.example.com
BACKUP_REMOTE_USER=backup
# Chemins serveur : remplacer graphlab par la valeur de APP_ID si différente
BACKUP_REMOTE_PATH=/data/graphlab/mongodb
BACKUP_SSH_KEY_PATH=/srv/graphlab/.ssh/backup_rsa
BACKUP_SSH_STRICT=accept-new
RETENTION_DAYS=30

# Production derrière Traefik (préfixe /graphlab = APP_ID) :
VITE_BASE_PATH=graphlab
# VITE_API_URL=https://portail.terra-numerica.org/graphlab/api

# Premier lancement : make app-up puis bash scripts/init-mongo.sh

# Historique des déploiements :

# Ajouter les entrées au fur et à mesure des évolutions majeures, avec la date de déploiement. 
# Conserver les entrées précédentes en les commentant pour garder une trace de l'historique des déploiements.

Version 1.0.0 => Initial release / 21 mai 2026
IMAGE_VERSION=1.0.0