{
    "name": "graphlab",
    "version": "1.0.0",
    "scripts": {
        "dev": "npm-run-all --parallel dev:backend dev:frontend:wait",
        "dev:install": "npm i && npm-run-all --parallel dev:backend:install dev:frontend:install:wait",
        "dev:frontend:wait": "npm-run-all --sequential wait-backend dev:frontend",
        "wait-backend": "wait-on tcp:3000",
        "dev:frontend": "cd app/frontend && npm run dev",
        "dev:frontend:install": "cd app/frontend && npm i && npm run dev",
        "dev:frontend:install:wait": "npm-run-all --sequential wait-backend dev:frontend:install",
        "dev:backend:install": "cd app/backend && npm i && npm run dev",
        "dev:backend": "cd app/backend && npm run dev",
        "build": "npm run build:backend && npm run build:frontend",
        "build:frontend": "cd app/frontend && npm run build",
        "build:backend": "cd app/backend && npm run build",
        "start": "npm-run-all --parallel start:backend start:frontend:wait",
        "start:frontend:wait": "npm-run-all --sequential wait-backend start:frontend",
        "start:frontend": "cd app/frontend && npm run preview",
        "start:backend": "cd app/backend && npm run start",
        "migrate:mongo": "tsx scripts/migrate-from-mongo.ts"
    },
    "devDependencies": {
        "mongodb": "^6.20.0",
        "tsx": "^4.20.6",
        "wait-on": "^7.2.0",
        "npm-run-all": "^4.1.5"
    }
}